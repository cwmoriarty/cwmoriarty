#!/bin/sh
# SynDirStat Service Management for Synology DSM

SYNOPKG_PKGDEST="/var/packages/syn-dirstat/target"
SYNOPKG_PKGVAR="/var/packages/syn-dirstat/var"
PID_FILE="${SYNOPKG_PKGVAR}/syndirstat.pid"
LOG_FILE="${SYNOPKG_PKGVAR}/syndirstat.log"
BIN="${SYNOPKG_PKGDEST}/bin/syndirstat"

start_daemon() {
    if [ -f "${PID_FILE}" ] && kill -0 $(cat "${PID_FILE}") 2>/dev/null; then
        echo "SynDirStat is already running."
        exit 0
    fi

    mkdir -p "${SYNOPKG_PKGVAR}"
    nohup "${BIN}" --host 0.0.0.0 --port 8742 --data-dir "${SYNOPKG_PKGVAR}" > "${LOG_FILE}" 2>&1 &
    PID=$!
    echo ${PID} > "${PID_FILE}"
    echo "SynDirStat started with PID ${PID} on port 8742."
}

stop_daemon() {
    if [ -f "${PID_FILE}" ]; then
        PID=$(cat "${PID_FILE}")
        if kill -0 ${PID} 2>/dev/null; then
            kill ${PID}
            sleep 1
            if kill -0 ${PID} 2>/dev/null; then
                kill -9 ${PID}
            fi
        fi
        rm -f "${PID_FILE}"
        echo "SynDirStat stopped."
    else
        echo "SynDirStat is not running."
    fi
}

daemon_status() {
    if [ -f "${PID_FILE}" ] && kill -0 $(cat "${PID_FILE}") 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

case "$1" in
    start)
        start_daemon
        exit 0
        ;;
    stop)
        stop_daemon
        exit 0
        ;;
    status)
        if daemon_status; then
            echo "SynDirStat is running."
            exit 0
        else
            echo "SynDirStat is stopped."
            exit 1
        fi
        ;;
    log)
        echo "${LOG_FILE}"
        exit 0
        ;;
    restart)
        stop_daemon
        sleep 1
        start_daemon
        exit 0
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|log}"
        exit 1
        ;;
esac
